        },
        {
          "name": "Activate User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/users/{{userId}}/activate"
          }
        },
        {
          "name": "Create User  Non-Admin (test 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hacker\",\n  \"email\": \"hacker@fundsroom.test\",\n  \"password\": \"Password@123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/users",
            "description": "Login as Sales first, then try this  should return 403"
          }
        }
      ]
    }
  ]
}
