{
  "info": {
    "name": "Mini ERP CRM",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "challanId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Login Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@fundsroom.test\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Customers - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/customers?limit=20&search="
      }
    },
    {
      "name": "Customers - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Anita Shah\",\n  \"mobile\": \"9876501234\",\n  \"email\": \"anita@example.com\",\n  \"businessName\": \"Shah Distributors\",\n  \"gstNumber\": \"27AAACS1234A1Z1\",\n  \"type\": \"DISTRIBUTOR\",\n  \"address\": \"Pune, Maharashtra\",\n  \"status\": \"LEAD\",\n  \"followUpDate\": \"2026-08-15T10:00:00.000Z\",\n  \"notes\": \"Interested in bulk order pricing.\"\n}"
        },
        "url": "{{baseUrl}}/customers"
      }
    },
    {
      "name": "Customers - Add Follow Up",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"Called customer and shared quotation.\"\n}"
        },
        "url": "{{baseUrl}}/customers/{{customerId}}/follow-ups"
      }
    },
    {
      "name": "Products - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/products?limit=20&search="
      }
    },
    {
      "name": "Products - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ceiling Fan 1200mm\",\n  \"sku\": \"SKU-FAN-1200\",\n  \"category\": \"Electrical\",\n  \"unitPrice\": 2200,\n  \"currentStock\": 40,\n  \"minimumStock\": 10,\n  \"location\": \"Mumbai Warehouse A\"\n}"
        },
        "url": "{{baseUrl}}/products"
      }
    },
    {
      "name": "Products - Stock Movement",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 10,\n  \"type\": \"IN\",\n  \"reason\": \"Purchase order received\"\n}"
        },
        "url": "{{baseUrl}}/products/{{productId}}/movements"
      }
    },
    {
      "name": "Challans - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/challans?limit=20&search="
      }
    },
    {
      "name": "Challans - Create Draft",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"status\": \"DRAFT\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/challans"
      }
    },
    {
      "name": "Challans - Confirm",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
        },
        "url": "{{baseUrl}}/challans/{{challanId}}/status"
      }
    }
  ]
}
